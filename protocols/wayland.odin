	&wl_fixes,
}

@(init, private)
wayland_init_types :: proc "contextless"() {
	wl_display_request_sync_types[0] = &wl_callback
	wl_display_request_get_registry_types[0] = &wl_registry
	wl_compositor_request_create_surface_types[0] = &wl_surface
	wl_compositor_request_create_region_types[0] = &wl_region
	wl_shm_pool_request_create_buffer_types[0] = &wl_buffer
	wl_shm_request_create_pool_types[0] = &wl_shm_pool
	wl_data_device_request_start_drag_types[0] = &wl_data_source
	wl_data_device_request_start_drag_types[1] = &wl_surface
	wl_data_device_request_start_drag_types[2] = &wl_surface
	wl_data_device_request_set_selection_types[0] = &wl_data_source
	wl_data_device_event_data_offer_types[0] = &wl_data_offer
	wl_data_device_event_enter_types[1] = &wl_surface
	wl_data_device_event_enter_types[4] = &wl_data_offer
	wl_data_device_event_selection_types[0] = &wl_data_offer
	wl_data_device_manager_request_create_data_source_types[0] = &wl_data_source
	wl_data_device_manager_request_get_data_device_types[0] = &wl_data_device
	wl_data_device_manager_request_get_data_device_types[1] = &wl_seat
	wl_shell_request_get_shell_surface_types[0] = &wl_shell_surface
	wl_shell_request_get_shell_surface_types[1] = &wl_surface
	wl_shell_surface_request_move_types[0] = &wl_seat
	wl_shell_surface_request_resize_types[0] = &wl_seat
	wl_shell_surface_request_set_transient_types[0] = &wl_surface
	wl_shell_surface_request_set_fullscreen_types[2] = &wl_output
	wl_shell_surface_request_set_popup_types[0] = &wl_seat
	wl_shell_surface_request_set_popup_types[2] = &wl_surface
	wl_shell_surface_request_set_maximized_types[0] = &wl_output
