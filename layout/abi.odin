package layout

import clay "deps:clay"

#assert(size_of(clay.Arena) == 24)
#assert(offset_of(clay.Arena, nextAllocation) == 0)
#assert(offset_of(clay.Arena, capacity) == 8)
#assert(offset_of(clay.Arena, memory) == 16)
#assert(size_of(clay.ElementDeclaration) == 248)
#assert(offset_of(clay.ElementDeclaration, layout) == 0)
#assert(offset_of(clay.ElementDeclaration, backgroundColor) == 40)
#assert(offset_of(clay.ElementDeclaration, overlayColor) == 56)
#assert(offset_of(clay.ElementDeclaration, cornerRadius) == 72)
#assert(offset_of(clay.ElementDeclaration, aspectRatio) == 88)
#assert(offset_of(clay.ElementDeclaration, image) == 96)
#assert(offset_of(clay.ElementDeclaration, floating) == 104)
#assert(offset_of(clay.ElementDeclaration, custom) == 136)
#assert(offset_of(clay.ElementDeclaration, clip) == 144)
#assert(offset_of(clay.ElementDeclaration, border) == 156)
#assert(offset_of(clay.ElementDeclaration, transition) == 184)
#assert(offset_of(clay.ElementDeclaration, userData) == 240)
#assert(size_of(clay.RenderCommand) == 80)
#assert(offset_of(clay.RenderCommand, boundingBox) == 0)
#assert(offset_of(clay.RenderCommand, renderData) == 16)
#assert(offset_of(clay.RenderCommand, userData) == 64)
#assert(offset_of(clay.RenderCommand, id) == 72)
#assert(offset_of(clay.RenderCommand, zIndex) == 76)
#assert(offset_of(clay.RenderCommand, commandType) == 78)
#assert(size_of(clay.ErrorData) == 32)
#assert(offset_of(clay.ErrorData, errorType) == 0)
#assert(offset_of(clay.ErrorData, errorText) == 8)
#assert(offset_of(clay.ErrorData, userData) == 24)
#assert(size_of(clay.ErrorHandler) == 16)
#assert(offset_of(clay.ErrorHandler, handler) == 0)
#assert(offset_of(clay.ErrorHandler, userData) == 8)
#assert(size_of(clay.LayoutConfig) == 40)
#assert(offset_of(clay.LayoutConfig, sizing) == 0)
#assert(offset_of(clay.LayoutConfig, padding) == 24)
#assert(offset_of(clay.LayoutConfig, childGap) == 32)
#assert(offset_of(clay.LayoutConfig, childAlignment) == 34)
#assert(offset_of(clay.LayoutConfig, layoutDirection) == 36)
#assert(size_of(clay.ImageRenderData) == 40)
#assert(align_of(clay.ImageRenderData) == 8)
#assert(offset_of(clay.ImageRenderData, backgroundColor) == 0)
#assert(offset_of(clay.ImageRenderData, cornerRadius) == 16)
#assert(offset_of(clay.ImageRenderData, imageData) == 32)
#assert(size_of(clay.ImageElementConfig) == 8)
#assert(offset_of(clay.ImageElementConfig, imageData) == 0)
#assert(size_of(clay.AspectRatioElementConfig) == 4)
#assert(offset_of(clay.AspectRatioElementConfig, aspectRatio) == 0)
