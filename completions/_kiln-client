#compdef kiln-client
_kiln_client() {
  local -a options verb_words candidates
  local i=2
  while (( i < CURRENT )); do
    case "${words[i]}" in
      --json) ((i+=1)) ;;
      -s|--socket)
        (( i+1 == CURRENT )) && return
        options+=(--socket "${words[i+1]}")
        ((i+=2)) ;;
      -h|--help) return ;;
      *) break ;;
    esac
  done
  if (( i == CURRENT )) && [[ "${words[CURRENT]}" == -* ]]; then
    compadd -- --json --socket --help -s -h
    return
  fi
  while (( i <= CURRENT )); do verb_words+=("${words[i]}"); ((i+=1)); done
  candidates=("${(@f)$("${words[1]}" "${options[@]}" complete "${#verb_words}" "${verb_words[@]}" 2>/dev/null)}")
  candidates=("${(@)candidates:#}")
  compadd -a candidates
}
_kiln_client "$@"
