package scanner

import "core:fmt"
import "core:os"
import "core:strings"
import "core:testing"
import "core:time"

FIXTURE :: `<protocol name="sample">
  <copyright>Fixture license must survive generation.</copyright>
  <interface name="sample_object" version="12">
    <request name="map" since="12">
      <arg name="i" type="int"/>
      <arg name="u" type="uint"/>
      <arg name="f" type="fixed"/>
      <arg name="s" type="string" allow-null="true"/>
      <arg name="o" type="object" interface="sample_object" allow-null="true"/>
      <arg name="n" type="new_id" interface="sample_object"/>
      <arg name="a" type="array"/>
      <arg name="h" type="fd"/>
    </request>
    <request name="bind"><arg name="id" type="new_id"/><arg name="peer" type="object" interface="sample_object"/></request>
    <request name="destroy" type="destructor" since="12"/>
    <event name="done" since="2"/>
    <enum name="mode">
      <entry name="90" value="1"/>
      <entry name="map" value="0xffffffff"/>
    </enum>
    <enum name="signed"><entry name="negative" value="-1"/></enum>
    <enum name="flags" bitfield="true">
      <entry name="one" value="1"/>
      <entry name="high" value="0x80000000"/>
    </enum>
    <enum name="mask" bitfield="true">
      <entry name="none" value="0"/>
      <entry name="both" value="3"/>
    </enum>
  </interface>
  <interface name="sample_empty" version="1"/>
</protocol>`

@(test)
scanner_preserves_signatures_types_and_enums :: proc(t: ^testing.T) {
	output, error := generate(FIXTURE, "fixture.xml", true)
	defer delete(output)
	if !testing.expect_value(t, error, "") { return }
	fragments := [?]string{
		"// Generated by kiln-scanner from fixture.xml. Do not edit.",
		"// Fixture license must survive generation.",
		`@(export, link_name = "sample_object_interface")`,
		`{"map", "12iuf?s?onah", &sample_object_request_map_types[0]}`,
		`sample_object_request_map_types: [8]^wl.Interface`,
		`sample_object_request_map_types[4] = &sample_object`,
		`sample_object_request_map_types[5] = &sample_object`,
		`{"bind", "suno", &sample_object_request_bind_types[0]}`,
		`sample_object_request_bind_types: [4]^wl.Interface`,
		`{"destroy", "12", &sample_object_request_destroy_types[0]}`,
		`{"done", "2", &sample_object_event_done_types[0]}`,
		"map_ = 0,", "bind = 1,", "destroy = 2,",
		"_90 = 1,", "map_ = 4294967295,", "negative = -1,",
		"Sample_Object_Flags :: bit_set[Sample_Object_Flags_Bit; u32]",
		"one = 0,", "high = 31,",
		"Sample_Object_Mask :: distinct u32",
		"Sample_Object_Mask_none :: Sample_Object_Mask(0)",
		"Sample_Object_Mask_both :: Sample_Object_Mask(3)",
		"Sample_Empty_Request :: enum u32 {\n}",
		"Sample_Empty_Event :: enum u32 {\n}",
		"\"sample_empty\", 1,\n\t0, nil,\n\t0, nil,",
	}
	for fragment in fragments { testing.expect(t, strings.contains(output, fragment), fragment) }
}

@(test)
scanner_can_omit_c_exports :: proc(t: ^testing.T) {
	output, error := generate(FIXTURE, "fixture.xml", false)
	defer delete(output)
	testing.expect_value(t, error, "")
	testing.expect(t, !strings.contains(output, "@(export"))
	testing.expect(t, strings.contains(output, "sample_object: wl.Interface"))
}

@(test)
checked_in_core_tables_are_reproducible :: proc(t: ^testing.T) {
	source :: "/usr/share/wayland/wayland.xml"
	input, read_error := os.read_entire_file(source, context.allocator)
	if !testing.expect(t, read_error == nil) { return }
	defer delete(input)
	output, error := generate(string(input), source, true)
	defer delete(output)
	testing.expect_value(t, error, "")
	testing.expect(t, output == string(#load("../protocols/wayland.odin")), "run make protocols after updating wayland.xml")
}

@(test)
scanner_rejects_unrepresentable_protocols :: proc(t: ^testing.T) {
	invalid := [?]string{
		`<protocol name="bad"><interface name="bad" version="0"/></protocol>`,
		`<protocol name="bad"><interface name="bad" version="1junk"/></protocol>`,
		`<protocol name="bad"><interface name="bad-name" version="1"/></protocol>`,
		`<protocol name="bad"><interface name="bad" version="1"/><interface name="bad" version="1"/></protocol>`,
		`<protocol name="bad"><interface name="bad" version="1"><event name="e" since="2"/></interface></protocol>`,
		`<protocol name="bad"><interface name="bad" version="1"><request name="r"><arg type="float"/></request></interface></protocol>`,
		`<protocol name="bad"><interface name="bad" version="1"><request name="r"><arg type="int" allow-null="true"/></request></interface></protocol>`,
		`<protocol name="bad"><interface name="bad" version="1"><request name="r"><arg type="array" allow-null="true"/></request></interface></protocol>`,
		`<protocol name="bad"><interface name="bad" version="1"><request name="r"><arg type="int" interface="bad"/></request></interface></protocol>`,
		`<protocol name="bad"><interface name="bad" version="1"><enum name="e"><entry name="x" value="4294967296"/></enum></interface></protocol>`,
		`<protocol name="bad"><interface name="bad" version="1"><enum name="e"><entry name="x" value="1junk"/></enum></interface></protocol>`,
		`<protocol name="bad"><interface name="bad" version="1"><enum name="e"><entry name="x"/></enum></interface></protocol>`,
		`<protocol name="bad"><interface name="bad" version="1"><request name="map"/><request name="map_"/></interface></protocol>`,
	}
	for input in invalid {
		output, error := generate(input, "invalid.xml", false)
		defer delete(output)
		testing.expect(t, error != "", input)
		testing.expect_value(t, output, "")
	}
}

@(test)
scanner_counts_expanded_new_ids_against_dispatch_limit :: proc(t: ^testing.T) {
	for count in 6..=7 {
		b: strings.Builder
		defer strings.builder_destroy(&b)
		strings.write_string(&b, `<protocol name="test"><interface name="test_object" version="1"><request name="bind">`)
		for i in 0..<count { fmt.sbprintf(&b, `<arg name="id%d" type="new_id"/>`, i) }
		strings.write_string(&b, `</request></interface></protocol>`)
		output, error := generate(strings.to_string(b), "limits.xml", false)
		defer delete(output)
		testing.expect(t, (error != "") == (count == 7))
	}
}

@(test)
generated_recursive_interfaces_compile_and_initialize :: proc(t: ^testing.T) {
	directory, directory_error := os.make_directory_temp("", "kiln-scanner-", context.allocator)
	if !testing.expect(t, directory_error == nil) { return }
	defer delete(directory)
	defer os.remove_all(directory)
	fixture_test :: `package protocols
import "core:testing"
@(test)
recursive_types :: proc(t: ^testing.T) {
    testing.expect(t, sample_object.methods[0].types[4] == &sample_object)
    testing.expect(t, sample_object.methods[0].types[5] == &sample_object)
    testing.expect(t, sample_object.methods[0].types[0] == nil)
    testing.expect(t, sample_object.methods[1].types[3] == &sample_object)
    testing.expect_value(t, string(sample_object.methods[1].signature), "suno")
    testing.expect_value(t, transmute(u32)Sample_Object_Flags{.one, .high}, u32(0x80000001))
    testing.expect_value(t, u32(Sample_Object_Mask_both), u32(3))
    testing.expect_value(t, u32(Sample_Object_Mode.map_), u32(0xffffffff))
}
`
	if !testing.expect(t, os.write_entire_file(fmt.tprintf("%s/fixture_test.odin", directory), fixture_test) == nil) { return }
	for export_c in ([2]bool{false, true}) {
		output, error := generate(FIXTURE, "fixture.xml", export_c)
		defer delete(output)
		if !testing.expect_value(t, error, "") { return }
		// The temporary package must resolve the same wire types as the checked-in output.
		standalone, allocated := strings.replace_all(output, "../wayland", "kiln:wayland")
		defer if allocated { delete(standalone) }
		if !testing.expect(t, os.write_entire_file(fmt.tprintf("%s/fixture.odin", directory), standalone) == nil) { return }
		process, start_error := os.process_start({stdout = os.stdout, stderr = os.stderr, command = {
			"odin", "test", directory, "-vet", fmt.tprintf("-out:%s/fixture-test", directory),
			"-collection:kiln=" + #directory + "..",
			"-extra-linker-flags:-Wl,--export-dynamic",
		}})
		if !testing.expect(t, start_error == nil) { return }
		state, wait_error := os.process_wait(process, 30 * time.Second)
		if !state.exited { _ = os.process_kill(process); _, _ = os.process_wait(process) }
		testing.expectf(t, wait_error == nil && state.exited && state.exit_code == 0, "compiler state %v: %v", state, wait_error)
	}
}
