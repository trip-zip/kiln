package scanner

import "core:encoding/xml"
import "core:fmt"
import "core:mem"
import "core:os"
import "core:strconv"
import "core:strings"

main :: proc() {
	args := os.args[1:]
	export_c := len(args) > 0 && args[0] == "--export-c"
	if export_c { args = args[1:] }
	if len(args) != 2 {
		fmt.eprintln("usage: kiln-scanner [--export-c] protocol.xml output.odin")
		os.exit(1)
	}
	arena: mem.Dynamic_Arena
	mem.dynamic_arena_init(&arena)
	defer mem.dynamic_arena_destroy(&arena)
	context.allocator = mem.dynamic_arena_allocator(&arena)
	context.temp_allocator = context.allocator
	input, read_error := os.read_entire_file(args[0], context.allocator)
	if read_error != nil { fmt.eprintln(args[0], read_error); os.exit(1) }
	output, error := generate(string(input), args[0], export_c)
	if error != "" { fmt.eprintln(args[0], error); os.exit(1) }
	if write_error := os.write_entire_file(args[1], transmute([]u8)output); write_error != nil {
		fmt.eprintln(args[1], write_error)
		os.exit(1)
	}
}

attribute :: proc(doc: ^xml.Document, id: xml.Element_ID, key: string) -> string {
	value, _ := xml.find_attribute_val_by_key(doc, id, key)
	return value
}

Children :: struct { doc: ^xml.Document, values: []xml.Value, tag: string, cursor: int }
children :: proc(doc: ^xml.Document, id: xml.Element_ID, tag: string) -> Children {
	return {doc = doc, values = doc.elements[id].value[:], tag = tag}
}
next :: proc(it: ^Children) -> (id: xml.Element_ID, ok: bool) {
	for it.cursor < len(it.values) {
		value := it.values[it.cursor]
		it.cursor += 1
		id = value.(xml.Element_ID) or_continue
		if it.doc.elements[id].ident == it.tag { return id, true }
	}
	return 0, false
}

valid_name :: proc(name: string, numeric := false) -> bool {
	if len(name) == 0 || name == "_" { return false }
	for c, i in name {
		if c == '_' || 'a' <= c && c <= 'z' || 'A' <= c && c <= 'Z' { continue }
		if '0' <= c && c <= '9' && (i > 0 || numeric) { continue }
		return false
	}
	return true
}

identifier :: proc(name: string) -> string {
	if '0' <= name[0] && name[0] <= '9' { return fmt.tprintf("_%s", name) }
	switch name {
	case "import", "foreign", "package", "typeid", "when", "where", "if", "else",
	     "for", "switch", "in", "not_in", "do", "case", "break", "continue",
	     "fallthrough", "defer", "return", "proc", "struct", "union", "enum",
	     "bit_set", "bit_field", "map", "dynamic", "auto_cast", "cast", "transmute",
	     "distinct", "using", "context", "or_else", "or_return", "or_break", "or_continue":
		return fmt.tprintf("%s_", name)
	}
	return name
}

type_name :: proc(name: string) -> string {
	result := strings.clone(name, context.temp_allocator)
	data := transmute([]u8)result
	upper := true
	for &c in data {
		if upper && 'a' <= c && c <= 'z' { c -= 'a' - 'A' }
		upper = c == '_'
	}
	return result
}

number :: proc(doc: ^xml.Document, id: xml.Element_ID, key: string, fallback: i64) -> (value: i64, ok: bool) {
	text := attribute(doc, id, key)
	if text == "" { return fallback, true }
	consumed: int
	value, ok = strconv.parse_i64(text, &consumed)
	return value, ok && consumed == len(text)
}

generate :: proc(input, source: string, export_c: bool) -> (output, error: string) {
	doc, parse_error := xml.parse(input)
	defer xml.destroy(doc)
	if parse_error != .None { return "", "invalid XML" }
	root := xml.Element_ID(0)
	if len(doc.elements) == 0 || doc.elements[root].ident != "protocol" || !valid_name(attribute(doc, root, "name")) { return "", "missing protocol name" }
	if error = validate(doc, root); error != "" { return }
	b: strings.Builder
	defer strings.builder_destroy(&b)
	w := strings.to_writer(&b)
	fmt.wprintf(w, "// Generated by kiln-scanner from %s. Do not edit.\npackage protocols\n\n", source)
	if copyright, exists := xml.find_child_by_ident(doc, root, "copyright"); exists {
		for value in doc.elements[copyright].value {
			text := value.(string) or_continue
			for line in strings.split_lines_iterator(&text) {
				trimmed := strings.trim_space(line)
				fmt.wprintln(w, fmt.tprintf("// %s", trimmed) if trimmed != "" else "//")
			}
		}
		fmt.wprintln(w)
	}
	fmt.wprintln(w, "import wl \"../wayland\"\n")
	interfaces := children(doc, root, "interface")
	for id in next(&interfaces) {
		name := attribute(doc, id, "name")
		requests := emit_messages(&b, doc, id, "request")
		events := emit_messages(&b, doc, id, "event")
		if export_c { fmt.wprintf(w, "@(export, link_name = %q)\n", fmt.tprintf("%s_interface", name)) }
		fmt.wprintf(w, "%s: wl.Interface = {{\n\t%q, %s,\n\t%d, %s,\n\t%d, %s,\n}}\n\n",
			identifier(name), name, attribute(doc, id, "version"),
			requests, fmt.tprintf("&%s_requests[0]", name) if requests > 0 else "nil",
			events, fmt.tprintf("&%s_events[0]", name) if events > 0 else "nil")
		enums := children(doc, id, "enum")
		for enumeration in next(&enums) { emit_enum(&b, doc, enumeration, name) }
	}
	fmt.wprintf(w, "%s_interfaces := [?]^wl.Interface{{\n", attribute(doc, root, "name"))
	interfaces = children(doc, root, "interface")
	for id in next(&interfaces) { fmt.wprintf(w, "\t&%s,\n", identifier(attribute(doc, id, "name"))) }
	fmt.wprintln(w, "}")
	emit_type_links(&b, doc, root)
	return strings.clone(strings.to_string(b)), ""
}

validate :: proc(doc: ^xml.Document, root: xml.Element_ID) -> string {
	names := make(map[string]bool)
	defer delete(names)
	interfaces := children(doc, root, "interface")
	for id in next(&interfaces) {
		name := attribute(doc, id, "name")
		version, version_ok := number(doc, id, "version", 0)
		if !valid_name(name) || names[name] || !version_ok || version < 1 || version > i64(max(i32)) {
			return "invalid or duplicate interface name or version"
		}
		names[name] = true
		for kind in ([3]string{"request", "event", "enum"}) {
			members := children(doc, id, kind)
			member_names := make(map[string]bool)
			defer delete(member_names)
			for member in next(&members) {
				member_name := attribute(doc, member, "name")
				since, since_ok := number(doc, member, "since", 1)
				if !valid_name(member_name) || member_names[identifier(member_name)] || !since_ok || since < 1 || since > version {
					return "invalid or duplicate member name or version"
				}
				member_names[identifier(member_name)] = true
				if kind == "enum" {
					entries := children(doc, member, "entry")
					entry_names := make(map[string]bool)
					defer delete(entry_names)
					for entry in next(&entries) {
						entry_name := attribute(doc, entry, "name")
						value, value_ok := number(doc, entry, "value", max(i64))
						if !valid_name(entry_name, true) || !value_ok || value < i64(min(i32)) || value > i64(max(u32)) {
							return "invalid enum entry name or value"
						}
						if entry_names[identifier(entry_name)] { return "duplicate enum entry name" }
						entry_names[identifier(entry_name)] = true
						if attribute(doc, member, "bitfield") == "true" && value < 0 { return "negative bitfield value" }
					}
					continue
				}
				args := children(doc, member, "arg")
				count := 0
				for arg in next(&args) {
					arg_kind := attribute(doc, arg, "type")
					iface := attribute(doc, arg, "interface")
					switch arg_kind {
					case "int", "uint", "fixed", "string", "object", "new_id", "array", "fd":
					case: return "unknown argument type"
					}
					if iface != "" && (!valid_name(iface) || (arg_kind != "object" && arg_kind != "new_id")) { return "invalid argument interface" }
					nullable := attribute(doc, arg, "allow-null")
					if nullable != "" && nullable != "false" && nullable != "true" { return "invalid allow-null value" }
					if nullable == "true" && arg_kind != "string" && arg_kind != "object" { return "argument type cannot be nullable" }
					count += 3 if arg_kind == "new_id" && iface == "" else 1
				}
				if count > 20 { return "message exceeds 20 wire arguments" }
			}
		}
	}
	if len(names) == 0 { return "protocol has no interfaces" }
	return ""
}

emit_messages :: proc(b: ^strings.Builder, doc: ^xml.Document, id: xml.Element_ID, kind: string) -> int {
	w := strings.to_writer(b)
	name := attribute(doc, id, "name")
	messages := children(doc, id, kind)
	count := 0
	for message in next(&messages) {
		member := attribute(doc, message, "name")
		args := children(doc, message, "arg")
		arg_count := 0
		for arg in next(&args) {
			arg_count += 3 if attribute(doc, arg, "type") == "new_id" && attribute(doc, arg, "interface") == "" else 1
		}
		// A non-nil types pointer also matches messages with no arguments.
		fmt.wprintf(w, "@(private)\n%s_%s_%s_types: [%d]^wl.Interface\n", name, kind, member, max(1, arg_count))
		count += 1
	}
	fmt.wprintf(w, "%s_%s :: enum u32 {{\n", type_name(name), type_name(kind))
	messages = children(doc, id, kind)
	opcode := 0
	for message in next(&messages) {
		fmt.wprintf(w, "\t%s = %d,\n", identifier(attribute(doc, message, "name")), opcode)
		opcode += 1
	}
	fmt.wprintln(w, "}\n")
	if count == 0 { return 0 }
	fmt.wprintf(w, "@(private)\n%s_%ss: [%d]wl.Message = {{\n", name, kind, count)
	messages = children(doc, id, kind)
	for message in next(&messages) {
		signature: strings.Builder
		defer strings.builder_destroy(&signature)
		sw := strings.to_writer(&signature)
		since, _ := number(doc, message, "since", 1)
		if since > 1 { fmt.wprintf(sw, "%d", since) }
		args := children(doc, message, "arg")
		for arg in next(&args) {
			if attribute(doc, arg, "allow-null") == "true" { fmt.wprint(sw, "?") }
			switch attribute(doc, arg, "type") {
			case "int": fmt.wprint(sw, "i")
			case "uint": fmt.wprint(sw, "u")
			case "fixed": fmt.wprint(sw, "f")
			case "string": fmt.wprint(sw, "s")
			case "object": fmt.wprint(sw, "o")
			case "new_id": fmt.wprint(sw, "sun" if attribute(doc, arg, "interface") == "" else "n")
			case "array": fmt.wprint(sw, "a")
			case "fd": fmt.wprint(sw, "h")
			}
		}
		member := attribute(doc, message, "name")
		fmt.wprintf(w, "\t{{%q, %q, &%s_%s_%s_types[0]}},\n", member, strings.to_string(signature), name, kind, member)
	}
	fmt.wprintln(w, "}\n")
	return count
}

// Package initialization breaks declaration cycles for recursive protocol interfaces.
emit_type_links :: proc(b: ^strings.Builder, doc: ^xml.Document, root: xml.Element_ID) {
	w := strings.to_writer(b)
	fmt.wprintf(w, "\n@(init, private)\n%s_init_types :: proc \"contextless\"() {{\n", attribute(doc, root, "name"))
	interfaces := children(doc, root, "interface")
	for id in next(&interfaces) {
		name := attribute(doc, id, "name")
		for kind in ([2]string{"request", "event"}) {
			messages := children(doc, id, kind)
			for message in next(&messages) {
				args := children(doc, message, "arg")
				index := 0
				for arg in next(&args) {
					iface := attribute(doc, arg, "interface")
					if iface != "" {
						fmt.wprintf(w, "\t%s_%s_%s_types[%d] = &%s\n", name, kind, attribute(doc, message, "name"), index, identifier(iface))
					}
					index += 3 if attribute(doc, arg, "type") == "new_id" && iface == "" else 1
				}
			}
		}
	}
	fmt.wprintln(w, "}")
}

emit_enum :: proc(b: ^strings.Builder, doc: ^xml.Document, id: xml.Element_ID, iface: string) {
	w := strings.to_writer(b)
	name := type_name(fmt.tprintf("%s_%s", iface, attribute(doc, id, "name")))
	bitfield := attribute(doc, id, "bitfield") == "true"
	single_bits, signed := bitfield, false
	entries := children(doc, id, "entry")
	for entry in next(&entries) {
		value, _ := number(doc, entry, "value", 0)
		single_bits = single_bits && value > 0 && value & (value - 1) == 0
		signed = signed || value < 0
	}
	if bitfield && !single_bits {
		fmt.wprintf(w, "%s :: distinct u32\n", name)
	} else if single_bits {
		fmt.wprintf(w, "%s :: bit_set[%s_Bit; u32]\n%s_Bit :: enum u8 {{\n", name, name, name)
	} else {
		fmt.wprintf(w, "%s :: enum %s {{\n", name, "i64" if signed else "u32")
	}
	entries = children(doc, id, "entry")
	for entry in next(&entries) {
		member := identifier(attribute(doc, entry, "name"))
		value, _ := number(doc, entry, "value", 0)
		if single_bits {
			bit := 0
			for value > 1 { value >>= 1; bit += 1 }
			fmt.wprintf(w, "\t%s = %d,\n", member, bit)
		} else if bitfield {
			fmt.wprintf(w, "%s_%s :: %s(%d)\n", name, member, name, value)
		} else {
			fmt.wprintf(w, "\t%s = %d,\n", member, value)
		}
	}
	if !bitfield || single_bits { fmt.wprintln(w, "}") }
	fmt.wprintln(w)
}
